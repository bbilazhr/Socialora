# SQLite file-based database — no external DB server needed for local dev/demo.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Change this in production.
JWT_SECRET="change-this-super-secret-value"

# --- AI (Socialora AI) ---
# Leave both empty to run in "offline demo mode": Socialora AI will still
# respond using real data-driven templates, just without a live LLM.
AI_PROVIDER="anthropic"          # "anthropic" | "openai" | ""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
